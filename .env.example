# Copy to .env and fill in. Referenced by name from config.json.
TZ=America/Los_Angeles
PUID=1000
PGID=1000

# Classic PAT with repo, read:org, read:user. If your work org uses SAML SSO,
# authorize the token for it (GitHub → Settings → Tokens → Configure SSO).
GITHUB_TOKEN_PERSONAL=

# Linear → Settings → Security & access → Personal API keys
LINEAR_API_KEY_WORK=

# How often the worker refreshes, and how many past days it re-checks each run.
INTERVAL_SECONDS=3600
DAYS_BACK=1
